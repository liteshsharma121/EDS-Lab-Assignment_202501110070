import pandas as pd
from itertools import combinations
from collections import Counter

# Prompt user to input the file name
file_name = input()

# Read data from the specified CSV file
df = pd.read_csv(file_name)

# write the code
grouped = df.groupby('Date')['Product'].apply(list)
prod_combo = []
for products in grouped :
	prod_combo.extend(combinations(sorted(set(products)),2))
combo = Counter(prod_combo)
max_count = combo.most_common(1)[0][1]
# Output the most frequent product pairs
for combo,count in combo.items() :
	if count == max_count :
		print(f"{combo[0]} and {combo[1]}: {count} times")

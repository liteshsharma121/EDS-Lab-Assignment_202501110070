import pandas as pd
import matplotlib.pyplot as plt

# Load the Titanic dataset
data = pd.read_csv('Titanic-Dataset.csv')

# Data Cleaning
data['Age'].fillna(data['Age'].median(), inplace=True)
data['Embarked'].fillna(data['Embarked'].mode()[0], inplace=True)
data.drop('Cabin', axis=1, inplace=True)

# Convert categorical features to numeric
data['Sex'] = data['Sex'].map({'male': 0, 'female': 1})
data = pd.get_dummies(data, columns=['Embarked'], drop_first=True)

# Write your code here for Box Plot for Age by Pclass
# 1. Create a boxplot of 'Age' grouped by 'Pclass'
data.boxplot(column='Age', by='Pclass')

# 2. Set the title of the plot
plt.title("Age by Pclass")

# 3. Remove the default pandas subtitle
plt.suptitle('')

# 4. Label the x-axis and y-axis
plt.xlabel('Pclass')
plt.ylabel('Age')

# Display the plot
plt.show()

